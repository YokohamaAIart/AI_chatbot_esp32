diff --git a/main/boards/lcdwiki-e32r28t/config.h b/main/boards/lcdwiki-e32r28t/config.h
new file mode 100644
index 0000000..6dc32a0
--- /dev/null
+++ b/main/boards/lcdwiki-e32r28t/config.h
@@ -0,0 +1,77 @@
+#ifndef _BOARD_CONFIG_H_
+#define _BOARD_CONFIG_H_
+
+// LCDWiki 2.8" ESP32-32E display (E32R28T touch / E32N28T no-touch)
+// Module ESP32-WROOM-32E (ESP32-D0WD-V3), 4 MB flash, NO PSRAM.
+// Ref: https://www.lcdwiki.com/2.8inch_ESP32-32E_Display
+
+#include <driver/gpio.h>
+
+// ---------------------------------------------------------------------------
+// Audio: the board has no microphone and its speaker amp (FM8002E) is fed by
+// the 8-bit internal DAC on IO26. We bypass both and run one duplex I2S bus on
+// the 4-pin "SPI peripheral" header (shared with the microSD slot -> do not
+// insert a card):
+//   IO18 -> BCLK  (INMP441 SCK + MAX98357A BCLK)
+//   IO23 -> WS    (INMP441 WS  + MAX98357A LRC)
+//   IO19 <- DIN   (INMP441 SD)
+//   IO27 -> DOUT  (MAX98357A DIN)
+// INMP441 L/R -> GND (left slot). Power from the 2P "expand" header (3V3/GND)
+// or the serial header 5V for the MAX98357A (louder).
+// Duplex runs both directions on one clock -> both rates must be equal.
+// 16 kHz = no resampler on the uplink (cheapest on a PSRAM-less ESP32).
+// ---------------------------------------------------------------------------
+#define AUDIO_INPUT_SAMPLE_RATE  16000
+#define AUDIO_OUTPUT_SAMPLE_RATE 16000
+
+#define AUDIO_I2S_GPIO_BCLK GPIO_NUM_18
+#define AUDIO_I2S_GPIO_WS   GPIO_NUM_23
+#define AUDIO_I2S_GPIO_DIN  GPIO_NUM_19
+#define AUDIO_I2S_GPIO_DOUT GPIO_NUM_27
+
+// Onboard FM8002E amp enable: LOW = on. Held HIGH so the unused DAC path stays silent.
+#define ONBOARD_AMP_EN_GPIO GPIO_NUM_4
+
+// ---------------------------------------------------------------------------
+// Buttons / LED
+// ---------------------------------------------------------------------------
+#define BOOT_BUTTON_GPIO    GPIO_NUM_0
+
+// RGB LED, common anode, active LOW.
+#define LED_R_GPIO          GPIO_NUM_22
+#define LED_G_GPIO          GPIO_NUM_16
+#define LED_B_GPIO          GPIO_NUM_17
+
+// Optional: XPT2046 PENIRQ (IO36, input-only, active LOW) as a push-to-talk
+// "button" — touch the screen to toggle chat. Untested on hardware: PENIRQ only
+// asserts while the controller sits in its power-up default mode. Set 1 to try.
+#define TOUCH_IRQ_AS_BUTTON 0
+#define TOUCH_IRQ_GPIO      GPIO_NUM_36
+
+// ---------------------------------------------------------------------------
+// Display: ILI9341V 240x320 TN, 4-wire SPI on HSPI (SPI2)
+// ---------------------------------------------------------------------------
+#define DISPLAY_SPI_HOST      SPI2_HOST
+#define DISPLAY_MOSI_PIN      GPIO_NUM_13
+#define DISPLAY_MISO_PIN      GPIO_NUM_NC   // IO12 is a strapping pin; not needed for write-only LCD
+#define DISPLAY_CLK_PIN       GPIO_NUM_14
+#define DISPLAY_CS_PIN        GPIO_NUM_15
+#define DISPLAY_DC_PIN        GPIO_NUM_2
+#define DISPLAY_RST_PIN       GPIO_NUM_NC   // tied to EN
+#define DISPLAY_BACKLIGHT_PIN GPIO_NUM_21
+#define DISPLAY_BACKLIGHT_OUTPUT_INVERT false
+#define DISPLAY_SPI_MODE      0
+#define DISPLAY_PCLK_HZ       (40 * 1000 * 1000)
+
+#define DISPLAY_WIDTH         240
+#define DISPLAY_HEIGHT        320
+// Tuning knobs if the image is mirrored / colours inverted / red<->blue swapped:
+#define DISPLAY_MIRROR_X      true
+#define DISPLAY_MIRROR_Y      false
+#define DISPLAY_SWAP_XY       false
+#define DISPLAY_INVERT_COLOR  false     // TN panel (non-IPS)
+#define DISPLAY_RGB_ORDER     LCD_RGB_ELEMENT_ORDER_BGR
+#define DISPLAY_OFFSET_X      0
+#define DISPLAY_OFFSET_Y      0
+
+#endif // _BOARD_CONFIG_H_
